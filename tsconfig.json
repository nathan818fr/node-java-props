{
  // Type-checks everything (sources, tests, tools). The published build uses tsconfig.build.json.
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "types": ["node"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "test", "tools", "*.mts"],
  // Compiled separately, by many TypeScript versions (test/compat/check-types.mjs)
  "exclude": ["test/compat/types"]
}
