{
  "name": "java-props",
  "version": "2.3.1",
  "description": "Read and write Java .properties files, with the syntax of Java's Properties.load().",
  "author": "Nathan Poirier <nathan@poirier.io>",
  "license": "MIT",
  "keywords": [
    "java",
    "properties",
    "java-properties",
    "reader",
    "parser"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nathan818fr/node-java-props.git"
  },
  "files": [
    "dist/**"
  ],
  "main": "dist/node-java-props.js",
  "browser": "dist/java-props.js",
  "sideEffects": false,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "lint": "biome check && tsc -p tsconfig.json",
    "format": "biome check --write",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "pretest:compat": "pnpm run build",
    "test:compat": "node test/compat/run-smoke.js && node test/compat/check-esm.mjs && node test/compat/check-package.mjs",
    "reference:gen": "node tools/gen-expected.mts",
    "reference:check": "node tools/gen-expected.mts --check",
    "reference:fuzz": "pnpm run build && node tools/fuzz.mts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
